{
  "name": "distribusi-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute distribusi-db --local --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute distribusi-db --local --file=./src/db/seed.sql",
    "db:reset": "wrangler d1 execute distribusi-db --local --file=./src/db/schema.sql && wrangler d1 execute distribusi-db --local --file=./src/db/seed.sql"
  },
  "dependencies": {
    "bcrypt-ts": "^9.0.2",
    "hono": "^4.7.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.14.0"
  }
}
